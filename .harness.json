  "forked": {},
  "freshness": {
    "auditDays": 7,
    "backlogPRs": 10,
    "backlogDays": 1
  },
  "impact": [
    {
      "id": "backlog-ledger",
      "when": [
        "docs/work/**"
      ],
      "then": "docs/BACKLOG.md is generated from the record and task sources: rebuild it, then the views that read it.",
      "run": "npm run work:build && npm run check:work",
      "checked": "check:work and check:backlog in CI",
      "after": []
    },
    {
      "id": "solution-views",
      "when": [
        ".solution.json",
        "docs/solution-order.md",
        "docs/BACKLOG.md",
        "tools/solution-overview.mjs",
        "tools/solution-overview-lib.mjs",
        "tools/solution.mjs"
      ],
      "then": "The generated overview and dashboard read these: regenerate both and commit them with their snapshot; reconcile docs/STYLE-GUIDE.md and docs/agents/gap-review.md when the overview layout or a gap rule changes.",
      "run": "npm run solution:refresh",
      "checked": "check:order in CI; the problems section of each view",
      "after": [
        "backlog-ledger"
      ]
    }
  ],
  "couplings": [],
  "outside": [
    {
      "what": "Each component backlog (docs/BACKLOG.md on main of nerv, gauntlet-protocol, project-harness, FPVBuddy, Grover) and its ledger layout",
      "affects": "docs/SOLUTION-OVERVIEW.md and docs/SOLUTION-DASHBOARD.md",
      "noticed": "Only on the next npm run solution:refresh; a layout the readers do not know shows as no records or a source problem"
    }
  ],
  "pages": [
    {
      "title": "Solution overview",
      "path": "docs/SOLUTION-OVERVIEW.md",
      "about": "Generated: solution order with live status, owner checks, blocked work and open work per component"
    },
    {
      "title": "Solution dashboard",
      "path": "docs/SOLUTION-DASHBOARD.md",
      "about": "Generated by the template tool: component sources, revisions and records"
    }
  ],
